<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The privacy manifest App Store Connect requires: no tracking, no data
     collected by the developer (everything stays between the app and your own
     pressbox server), and UserDefaults used only for the app's own settings. -->
<plist version="1.0">
  <dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
      <dict>
        <key>NSPrivacyAccessedAPIType</key>
        <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
        <key>NSPrivacyAccessedAPITypeReasons</key>
        <array>
          <!-- Reading and writing information only accessible to the app itself. -->
          <string>CA92.1</string>
        </array>
      </dict>
    </array>
  </dict>
</plist>
